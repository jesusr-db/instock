# Copy to app/.env and fill in for local development.
# In Databricks Apps these are injected from app/app.yml automatically;
# DATABRICKS_HOST and DATABRICKS_TOKEN are auto-provisioned by the platform.

# Workspace connection (auto-injected in deployed apps)
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_TOKEN=dapi-your-personal-access-token

# Model route — this is the AI Gateway endpoint name
# Discovered live by setup/discover_endpoint.py and written to setup/endpoint_name.txt
MODEL_ROUTE=aigwjmr

# Unity Catalog tables (use *_dev schema for local development)
INVENTORY_TABLE=vdm_classic_rikfy0_catalog.instockcv_dev.inventory
SCAN_LOG_TABLE=vdm_classic_rikfy0_catalog.instockcv_dev.scan_log

# Storage location for uploaded scan images (UC volume in deployed app)
IMAGE_VOLUME_PATH=/tmp/instockcv_images

# SQL warehouse HTTP path — auto-selected during deploy
SQL_WAREHOUSE_HTTP_PATH=/sql/1.0/warehouses/5067b513037fbf07

# Optional: enable two-stage detection pipeline (default false)
# USE_DETECTION_STAGE=false

# Optional: comma-separated extra model routes shown in the dropdown
# ADDITIONAL_MODEL_ROUTES=instockcv-qwen3vl
